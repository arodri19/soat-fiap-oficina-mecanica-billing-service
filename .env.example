PORT=4100
JWT_SECRET=sua_chave_jwt_aqui

# ── AWS (SQS + DynamoDB) ──────────────────────────────────────────────────────
QUEUE_PREFIX=oficina-mecanica-dev
AWS_REGION=us-east-1
# LocalStack: http://localhost:4566 — vazio = AWS real
SQS_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Mercado Pago (https://www.mercadopago.com.br/developers/pt) ───────────────
# fake = simulação local | mercadopago = API real (token da seção "Credenciais de teste" — prefixo TEST- ou APP_USR-)
PAYMENT_GATEWAY=fake
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
# Polling das cobranças pendentes (consulta o Mercado Pago a cada N ms; 0 desliga).
# Funciona sem URL pública — o webhook é opcional.
PAYMENT_POLL_INTERVAL_MS=30000
# URL pública https do billing — vira notification_url (ex.: túnel ngrok em dev)
PUBLIC_BASE_URL=http://localhost:4100

# ── New Relic ─────────────────────────────────────────────────────────────────
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-billing-service
LOG_LEVEL=info
